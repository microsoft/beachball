{
  // Use IntelliSense to learn about possible Node.js debug attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug current open test",
      "runtimeExecutable": null,
      "program": "${workspaceRoot}/scripts/debugTests.ts",
      "cwd": "${fileDirname}",
      "runtimeArgs": ["--nolazy", "--inspect", "--experimental-vm-modules"],
      "args": ["${fileBasename}"],
      "sourceMaps": true,
      "outputCapture": "std",
      // "runtimeVersion": "22",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug beachball change (MUST BUILD FIRST)",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": ["bin/beachball.js", "change"],
      "sourceMaps": true,
      "outputCapture": "std",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach by Process ID",
      "processId": "${command:PickProcess}",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug yarn npmrc auth",
      "runtimeExecutable": "yarn",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": ["npm", "info", "beachball@asdfdsfsdf"],
      "env": {
        "YARN_NPMRC_AUTH_ENABLED": "true",
        "YARN_NPMRC_AUTH_VERBOSE": "true",
        "YARN_NPM_ALWAYS_AUTH": "true",
        "YARN_NPM_REGISTRY_SERVER": "https://pkgs.dev.azure.com/office/_packaging/Office/npm/registry/"
      },
      "sourceMaps": true,
      "outputCapture": "std",
      "console": "integratedTerminal"
    }
  ]
}
