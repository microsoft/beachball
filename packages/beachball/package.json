{
  "name": "beachball",
  "version": "3.0.0-alpha.0",
  "description": "The Sunniest Semantic Version Bumper",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/beachball",
    "directory": "packages/beachball"
  },
  "homepage": "https://microsoft.github.io/beachball/",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": "./bin/beachball.js",
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "bin",
    "dist",
    "lib/!(__*)",
    "lib/!(__*)/**/*"
  ],
  "scripts": {
    "build": "yarn run -T tsc --pretty",
    "bundle": "node ../../scripts/bundleNode.ts src/githubAuth/appTokenBin.ts github-app-token",
    "depcheck": "yarn run -T depcheck .",
    "lint": "yarn run -T eslint --color --max-warnings=0 src",
    "start": "yarn run -T tsc -w --preserveWatchOutput",
    "test": "cross-env NODE_OPTIONS='--experimental-vm-modules' yarn run -T jest",
    "test:all": "yarn test:unit && yarn test:func && yarn test:e2e",
    "test:e2e": "yarn test --selectProjects e2e",
    "test:func": "yarn test --selectProjects functional",
    "test:unit": "yarn test --selectProjects unit",
    "test:watch": "yarn test --watch",
    "update-snapshots": "yarn test:unit -u && yarn test:func -u && yarn test:e2e -u"
  },
  "dependencies": {
    "@vercel/detect-agent": "^1.2.1",
    "commander": "catalog:prod",
    "nano-spawn": "catalog:prod",
    "p-graph": "workspace:^",
    "p-limit": "^3.1.0",
    "prompts": "^2.4.2",
    "semver": "catalog:prod",
    "workspace-tools": "catalog:prod"
  },
  "devDependencies": {
    "@microsoft/beachball-scripts": "workspace:^",
    "@microsoft/beachball-test-utilities": "workspace:^",
    "@types/prompts": "^2.4.2",
    "@types/semver": "catalog:dev",
    "cross-env": "catalog:dev",
    "strip-ansi": "^6.0.1",
    "undici": "^8.9.0"
  }
}
