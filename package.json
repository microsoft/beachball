{
  "name": "@microsoft/beachball-monorepo",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/beachball"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.18.0 || >=24"
  },
  "workspaces": [
    "actions/*",
    "packages/*",
    "renovate",
    "scripts",
    "skills",
    "yarn-plugins/*"
  ],
  "scripts": {
    "build": "lage build bundle",
    "bump": "beachball bump",
    "change": "beachball change",
    "checkchange": "beachball check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "lint": "lage lint",
    "beachball:release": "beachball -c beachball.release.js",
    "syncpack:check": "syncpack lint",
    "syncpack:update": "syncpack fix",
    "test": "lage test",
    "update-snapshots": "lage update-snapshots"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-transform-modules-commonjs": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@eslint/js": "^10.0.0",
    "@jest/globals": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/yargs-parser": "^21.0.0",
    "@typescript-eslint/utils": "^8.52.0",
    "babel-jest": "^30.0.0",
    "beachball": "workspace:^",
    "depcheck": "^1.4.7",
    "eslint": "catalog:dev",
    "husky": "^9.0.0",
    "jest": "^30.0.0",
    "lage": "^2.15.0",
    "lint-staged": "^16.0.0",
    "prettier": "~3.9.0",
    "syncpack": "^15.0.0",
    "ts7": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "resolutions": {
    "@types/node": "^22.0.0",
    "lodash": "^4.18.1",
    "@cypress/request/qs@~6.14.1": "^6.15.1",
    "@cypress/request/uuid@^8.3.2": "^14.0.0",
    "@verdaccio/core/ajv@8.17.1": "^8.18.0",
    "@verdaccio/core/ajv@8.18.0": "^8.18.0",
    "verdaccio/express@4.22.1": "^4.22.1",
    "verdaccio-audit/express@4.22.1": "^4.22.1",
    "@verdaccio/middleware/express@4.22.1": "^4.22.1",
    "@verdaccio/core/minimatch@7.4.6": "^7.4.9",
    "verdaccio/minimatch@7.4.6": "^7.4.9",
    "verdaccio-memory/minimatch@7.4.6": "^7.4.9"
  },
  "rationale": {
    "resolutions": {
      "lodash": "Unpin due to security issue",
      "*/express": "Unpin to allow regular security updates",
      "*/qs": "Unpin due to security issue",
      "*/uuid": "update due to security issue (only node version update breaks)"
    }
  }
}
