{
  "name": "@microsoft/beachball-monorepo",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/beachball"
  },
  "license": "MIT",
  "engines": {
    "node": "^14.13.0 || >=16"
  },
  "workspaces": [
    "packages/*",
    "scripts"
  ],
  "scripts": {
    "beachball": "node ./packages/beachball/lib/cli.js",
    "build": "lage build",
    "bump": "yarn beachball bump",
    "change": "yarn beachball change",
    "checkchange": "yarn beachball check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install",
    "lint": "lage lint",
    "release": "yarn beachball publish -y",
    "test": "lage test",
    "update-snapshots": "lage update-snapshots"
  },
  "lint-staged": {
    "*": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@jest/globals": "^29.0.0",
    "@types/node": "^14.0.0",
    "@types/yargs-parser": "^21.0.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "@typescript-eslint/utils": "^5.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-etc": "^2.0.3",
    "husky": "^8.0.0",
    "jest": "^29.0.0",
    "lage": "^2.15.17",
    "lint-staged": "^12.0.0",
    "prettier": "~2.8.4",
    "ts-jest": "^29.2.6",
    "typescript": "~5.2.0"
  },
  "resolutions": {
    "@types/node@npm:*": "^14.0.0",
    "handlebars@npm:4.7.8": "^4.7.9",
    "js-yaml@npm:4.1.0": "^4.1.0",
    "lodash": "^4.18.1",
    "minimatch@npm:7.4.6": "^7.4.6",
    "qs@npm:6.10.4": "^6.14.2",
    "qs@npm:6.11.0": "^6.14.2",
    "semver@npm:7.5.4": "^7.7.4",
    "validator@npm:13.11.0": "^13.15.22"
  },
  "rationale": {
    "resolutions": {
      "lodash": "Unpin due to security issue",
      "qs": "Unpin due to security issue",
      "semver": "Unpin due to security issues",
      "minimatch": "Unpin due to security issues"
    }
  }
}
